# Port the Next.js server listens on inside the container
PORT=3000

# PostgreSQL connection string. On Dokploy, create a Database resource
# (Postgres) and paste its internal connection string here. Migrations run
# automatically on server boot (see src/instrumentation.ts).
DATABASE_URL=postgres://user:password@host:5432/fundsflow

# Secret used to sign session cookies. Required in production — the app
# throws on startup of any authenticated request if this is unset.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# AI chat/recap/forecast (Money Buddy). Generic OpenAI-compatible
# chat-completions config -- no provider-specific code, so swapping
# providers is just changing these three values.
AI_BASE_URL=https://macpenielit.dpdns.org/v1
AI_API_KEY=
AI_MODEL=auto/chat

# Per-user throttle on the routes that call the AI, so a stuck client or a kid
# leaning on the send button can't run up a bill. Counted in-process, so the
# allowance is per container instance. Defaults shown.
RATE_LIMIT_CHAT=20          # messages per minute
RATE_LIMIT_INSIGHT=10       # recap/forecast per minute
RATE_LIMIT_STATEMENT=5      # statement uploads per 5 minutes

# Bill reminders (web push). Optional -- with these unset the app behaves
# exactly as before and Settings says reminders aren't available.
# Generate a key pair once with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret for the reminder job. Point a daily scheduled task at
# POST /api/cron/reminders with header:  Authorization: Bearer <this value>
CRON_SECRET=
