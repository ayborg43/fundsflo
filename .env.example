# Port the Next.js server listens on inside the container
PORT=3000

# Directory where user accounts and each user's balance/transactions/goals
# are persisted as JSON. Mount a Dokploy volume at this path so data
# survives redeploys.
DATA_DIR=/app/data

# Secret used to sign session cookies. Required in production — the app
# throws on startup of any authenticated request if this is unset.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=
