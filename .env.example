# Port the Next.js server listens on inside the container
PORT=3000

# PostgreSQL connection string. On Dokploy, create a Database resource
# (Postgres) and paste its internal connection string here. Migrations run
# automatically on server boot (see src/instrumentation.ts).
DATABASE_URL=postgres://user:password@host:5432/freezefund

# Secret used to sign session cookies. Required in production — the app
# throws on startup of any authenticated request if this is unset.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=
